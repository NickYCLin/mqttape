{
  "name": "mqttape",
  "version": "0.12.1",
  "description": "Capture, inspect, and replay MQTT traffic.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "main": "out/main/index.js",
  "author": {
    "name": "NickYCLin",
    "email": "113652814+NickYCLin@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "broker:dev": "node scripts/dev-broker.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "npm run typecheck && vite build --config vite.web.config.ts",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "package:store": "npm run build && electron-builder --config electron-builder.store.config.mjs --publish never",
    "package:store:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-store-bundle.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:web && playwright test",
    "test:e2e:ci": "playwright test"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "cbor-x": "^1.6.6",
    "electron-updater": "^6.8.9",
    "mqtt": "^5.14.1",
    "protobufjs": "^8.7.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "aedes": "^1.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "mqtt-packet": "^9.0.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "io.github.nickyclin.mqttape",
    "productName": "MQTTape",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/cbor-extract{,/**/*}",
      "!node_modules/@cbor-extract{,/**/*}"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronUpdaterCompatibility": ">=2.16",
    "publish": {
      "provider": "github",
      "owner": "NickYCLin",
      "repo": "MQTTape"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  }
}
